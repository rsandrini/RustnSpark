// Base schema for the Rust and Spark API. Grows migration-by-migration per plan Appendix B:
// no speculative tables here, only what the current migration needs.
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [btree_gist]
}

enum AccountRole {
  PLAYER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  BANNED
}

model Account {
  id            String         @id @default(dbgenerated("gen_random_uuid()"))
  // Plain unique string: lowercasing is the service layer's job (R17), not a DB constraint.
  email         String         @unique
  passwordHash  String
  role          AccountRole    @default(PLAYER)
  status        AccountStatus  @default(ACTIVE)
  createdAt     DateTime       @default(now())
  player        Player?
  refreshTokens RefreshToken[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  accountId String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model Player {
  id              String            @id @default(dbgenerated("gen_random_uuid()"))
  accountId       String            @unique
  account         Account           @relation(fields: [accountId], references: [id])
  name            String            @unique
  credits         Int               @default(0)
  // Plain string, not an enum: `pt-BR` is not a valid enum member; DTO validation enforces values.
  locale          String            @default("en")
  // Faction chosen during onboarding; null until a player completes onboarding.
  factionId       String?
  // Owner debug switch, per account (never global — a global flag would speed up every
  // player's jobs): while true, this player's timed jobs (missions, travel, scavenging,
  // repair) still show and store their real duration, but actually finish after
  // admin.debug_fast_ops_seconds. Off for everyone by default; set only by an admin.
  debugFastOps    Boolean           @default(false)
  createdAt       DateTime          @default(now())
  events          PlayerEvent[]
  idempotencyKeys IdempotencyKey[]
  parts           PartInstance[]
  ships           Ship[]
  materials       PlayerMaterial[]
  missions        MissionInstance[]
  missionLogs     MissionLog[]
  scavengeCounters ScavengeCounter[]

  // S11.3: new players per analytics window.
  @@index([createdAt])
}

model RefreshToken {
  id           String    @id @default(dbgenerated("gen_random_uuid()"))
  accountId    String
  account      Account   @relation(fields: [accountId], references: [id])
  familyId     String
  tokenHash    String
  expiresAt    DateTime
  revokedAt    DateTime?
  // Plain nullable column (no FK): rotation bookkeeping only, per the plan's field list.
  replacedById String?

  @@index([familyId])
  // rotate() looks up every refresh request by tokenHash; no row is ever deleted (only
  // revokedAt is set), so this table grows unbounded and needs its own index, not just familyId.
  @@index([tokenHash])
  @@index([expiresAt])
}

model PlayerEvent {
  id           String   @id @default(dbgenerated("gen_random_uuid()"))
  playerId     String
  player       Player   @relation(fields: [playerId], references: [id])
  at           DateTime @default(now())
  type         String
  payload      Json?
  creditsDelta Int?

  @@index([playerId, at])
  // S11.3: global time windows — active players filter on `at` alone, wallet flows on (type, at).
  @@index([at])
  @@index([type, at])
}

model IdempotencyKey {
  key            String
  playerId       String
  route          String
  requestHash    String
  responseStatus Int
  responseBody   String
  expiresAt      DateTime
  player         Player   @relation(fields: [playerId], references: [id])

  @@id([playerId, route, key])
}

// S8.5 review (items 8–9): one row per (player, location) instead of scanning the
// player's whole scavenging event history for the cooldown and attempt number.
// attemptCount is both the anti-farming counter and the drop-roll seed index;
// lastAttemptAt drives the D28 cooldown, read through the injected Clock.
model ScavengeCounter {
  playerId      String
  locationId    String
  attemptCount  Int       @default(0)
  lastAttemptAt DateTime?
  player        Player    @relation(fields: [playerId], references: [id])
  location      Location  @relation(fields: [locationId], references: [id])

  @@id([playerId, locationId])
}

enum Rarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

enum PartClass {
  ENGINE
  TANK
  BATTERY
  REACTOR
  WEAPON
  DEFENSE
  CARGO
  SENSOR
  UTILITY
  BRIDGE
}

enum MissionType {
  DELIVERY
  TRANSPORT
  ESCORT
  MINING
  RESCUE
  // A trip the pilot asks for on their own: no cargo, no reward, only fuel (never on a board).
  TRAVEL
  // A timed search of the wreckage around a port: starts and ends in the same place, no reward,
  // finds used parts or scrap when it resolves (never on a board).
  SCAVENGE
  // A race against generated rival ships (3-5): needs a fast ship, pays by finishing place.
  RACE
}

// Board/instance lifecycle (plan S6.1). Distinct from the resolution outcome union
// ('success' | 'failed' | 'adrift' | 'partial_failure') defined in mission.resolver.ts —
// that one records what happened during resolution; this one tracks the mission row itself.
enum MissionStatus {
  AVAILABLE
  HELD
  ACCEPTED
  IN_TRANSIT
  RESOLVING
  DONE
  FAILED
  EXPIRED
}

enum PartLocation {
  INVENTORY
  INSTALLED
}

enum ShipStatus {
  IN_PORT
  ON_MISSION
  ADRIFT
}

enum ShipStance {
  DEFENSIVE
  NEUTRAL
  AGGRESSIVE
}

model GameConfig {
  key         String   @id
  value       Json
  type        String
  description Json
  updatedAt   DateTime @updatedAt
  updatedBy   String?
}

model TuningRevision {
  id         BigInt   @id @default(autoincrement())
  at         DateTime @default(now())
  actor      String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  reason     String

  @@index([entityType, entityId, id(sort: Desc)])
}

// S11.1: audit trail for every NON-tuning admin write (support actions, flags,
// broadcast, maintenance) — actor, action, target, before/after, ip. Tuning
// writes are audited through TuningRevision above (S3.7/S3.8), never here.
model AdminAuditLog {
  id     BigInt   @id @default(autoincrement())
  at     DateTime @default(now())
  actor  String
  action String
  target String?
  before Json?
  after  Json?
  ip     String?

  @@index([action, id(sort: Desc)])
  @@index([target, id(sort: Desc)])
}

// S11.2: runtime feature flags — boolean key/value switches read per request from the
// row itself, so a write is effective without a restart. Unknown keys read as their
// caller-provided fallback (e.g. register.open defaults true, maintenance defaults false).
model SystemFlag {
  key       String   @id
  value     Boolean  @default(false)
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// S11.2: broadcast notices — active ones are served to players as they are written.
// message is LocalizedText { en, pt-BR }; the actor of each change lives in AdminAuditLog.
model SystemNotice {
  id          String    @id @default(dbgenerated("gen_random_uuid()"))
  message     Json
  active      Boolean   @default(true)
  createdBy   String
  createdAt   DateTime  @default(now())
  dismissedAt DateTime?

  @@index([active, createdAt(sort: Desc)])
}

model RulesSnapshot {
  hash        String       @id
  rules       Json
  createdAt   DateTime     @default(now())
  missionLogs MissionLog[]

  @@index([createdAt])
}

model Faction {
  id               String            @id
  displayName      Json
  description      Json
  color            String
  playable         Boolean           @default(false)
  relations        Json
  starterKitHint   Json?
  locations        Location[]
  missionTemplates MissionTemplate[]
  missionInstances MissionInstance[]
}

model Environment {
  id                String             @id
  displayName       Json
  description       Json
  level             Int
  fuelMult          Float              @default(1)
  subsystemTarget   String?
  mitigatingPart    String?
  routeEnvironments RouteEnvironment[]
}

model Location {
  id                  String            @id
  displayName         Json
  description         Json
  type                String
  x                   Float
  y                   Float
  zone                Int
  factionId           String
  isolation           Float
  mood                Float
  services            Json
  faction             Faction           @relation(fields: [factionId], references: [id])
  routesA             Route[]           @relation("RouteA")
  routesB             Route[]           @relation("RouteB")
  ships               Ship[]
  missionsOrigin      MissionInstance[] @relation("MissionOrigin")
  missionsDestination MissionInstance[] @relation("MissionDestination")
  scavengeCounters    ScavengeCounter[]

  @@index([factionId])
}

model Route {
  id                String             @id
  nodeAId           String
  nodeBId           String
  distance          Int
  danger            Int
  nodeA             Location           @relation("RouteA", fields: [nodeAId], references: [id])
  nodeB             Location           @relation("RouteB", fields: [nodeBId], references: [id])
  routeEnvironments RouteEnvironment[]
  presences         RoutePresence[]
  encounters        Encounter[]

  @@unique([nodeAId, nodeBId])
  @@index([nodeBId])
}

model RouteEnvironment {
  routeId       String
  environmentId String
  order         Int
  route         Route       @relation(fields: [routeId], references: [id], onDelete: Cascade)
  environment   Environment @relation(fields: [environmentId], references: [id])

  @@id([routeId, environmentId, order])
  @@index([environmentId])
}

model PartCatalog {
  partType      String         @id
  displayName   Json
  description   Json
  partClass     PartClass
  rarity        Rarity
  w             Int
  h             Int
  mass          Float
  structureCost Int
  basePrice     Int
  scrapValue    Int
  partHp        Int
  pot           Float          @default(0)
  pdf           Float          @default(0)
  bli           Float          @default(0)
  esc           Float          @default(0)
  sen           Float          @default(0)
  crg           Float          @default(0)
  min           Float          @default(0)
  energyCont    Float          @default(0)
  energyCombat  Float          @default(0)
  fuelCap       Int?
  fuelUse       Float?
  batCharge     Float?
  batOutput     Float?
  batInput      Float?
  specialProp      Json?
  connectorLayouts Json?
  connectorRules   Json?
  active           Boolean        @default(true)
  instances        PartInstance[]
}

model MissionTemplate {
  id              String            @id
  displayName     Json
  description     Json
  type            MissionType
  factionId       String
  requirements    Json
  rewardCalc      Json
  deadlineCalc    Json
  encounterPolicy Json
  active          Boolean           @default(true)
  faction         Faction           @relation(fields: [factionId], references: [id])
  instances       MissionInstance[]

  @@index([factionId])
}

model MissionInstance {
  id            String          @id @default(dbgenerated("gen_random_uuid()"))
  templateId    String
  type          MissionType
  factionId     String
  originId      String
  destinationId String
  // Structured leg plan (distance/danger/zone/env per leg) — never narrated text (GDD §MissionLog).
  legs          Json
  // Per-type payload (mining quantity/material, escort client, rescue mob, cargo manifest…).
  cargo         Json
  // Integer credits (wallet is integer-only; MAX_CREDITS fits Int).
  reward        Int
  // Board/hold deadline: the hold timer keeps running against this (GDD §12).
  expiresAt     DateTime
  // S11.3: when the offer was generated (board refill). Window for the analytics
  // generation-vs-consumption-per-zone aggregate; migration 0021 backfills it from
  // COALESCE(acceptedAt, expiresAt) because no creation time was recorded before.
  createdAt     DateTime          @default(now())
  status        MissionStatus   @default(AVAILABLE)
  playerId      String?
  shipId        String?
  acceptedAt    DateTime?
  arrivalAt     DateTime?
  // Completion deadline (rescue: round-trip at reference_mob × uniform(1.25, 2.0)); nullable
  // because only some mission types carry one.
  deadlineAt    DateTime?
  // Deterministic generator input (e.g. "ceres|12|cfg-abc"): always pass the stored string
  // to createRng() — never Number() it, or the stream changes. TEXT so no bit-width ceiling.
  seed          String
  // D43: set on a player's private start-safe mission — only that player sees it, holds it or
  // accepts it. NULL for every normal (shared) board offer. Plain column, no relation: it is
  // never joined, only compared.
  privatePlayerId String?
  // Optimistic lock (S6.4 state machine increments on every transition).
  version       Int             @default(0)
  template      MissionTemplate @relation(fields: [templateId], references: [id])
  faction       Faction         @relation(fields: [factionId], references: [id])
  origin        Location        @relation("MissionOrigin", fields: [originId], references: [id])
  destination   Location        @relation("MissionDestination", fields: [destinationId], references: [id])
  player        Player?         @relation(fields: [playerId], references: [id])
  ship          Ship?           @relation(fields: [shipId], references: [id])
  // Hand-written partial indexes live only in migration 0012_missions (Prisma PSL cannot
  // express WHERE): status/arrivalAt for IN_TRANSIT, and the one-active-per-player unique
  // over (ACCEPTED, IN_TRANSIT, RESOLVING).

  missionLogs MissionLog[]
  presences   RoutePresence[]
  encountersA Encounter[]     @relation("EncounterMissionA")
  encountersB Encounter[]     @relation("EncounterMissionB")

  // Board query: what is offerable at this location, soonest deadline first.
  @@index([originId, status, expiresAt])
  // A player's private offers at a location (D43).
  @@index([privatePlayerId, originId, status])
  // S11.3: analytics windows — generation per zone (createdAt) and consumption (acceptedAt).
  @@index([createdAt])
  @@index([acceptedAt])
}

model MissionLog {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  missionId     String          @unique @db.VarChar(36)
  playerId      String          @db.VarChar(36)
  // D19 replay inputs are bounded strings: the S7.1 schema test rejects any TEXT column
  // in this table, so every string column declares an explicit VarChar ceiling.
  seed          String          @db.VarChar(512)
  rulesHash     String          @db.VarChar(64)
  outcome       String          @db.VarChar(32)
  shipSnapshot  Json
  legs          Json
  // 2 = enriched events (S9.0/D36: cascade, failure consequence, fuelLost);
  // v1 rows written before the upgrade keep their stored 1 and stay readable.
  schemaVersion Int             @default(2)
  createdAt     DateTime        @default(now())
  mission       MissionInstance @relation(fields: [missionId], references: [id])
  player        Player          @relation(fields: [playerId], references: [id])
  rulesSnapshot RulesSnapshot   @relation(fields: [rulesHash], references: [hash])

  @@index([playerId, createdAt])
  // S11.3: mission success rate and pirate-encounter winrate are per-window scans
  // across every player, not per-player reads.
  @@index([createdAt])
}

model RoutePresence {
  id        String                   @id @default(dbgenerated("gen_random_uuid()"))
  missionId String
  shipId    String
  routeId   String
  legIndex  Int
  window    Unsupported("tstzrange")
  mission   MissionInstance          @relation(fields: [missionId], references: [id])
  ship      Ship                     @relation(fields: [shipId], references: [id])
  route     Route                    @relation(fields: [routeId], references: [id])

  // The overlap (&&) query must answer from this GiST index, not a seq scan: the S7.1
  // EXPLAIN test turns seq scans off and asserts the planner picks RoutePresence_window_idx.
  @@index([window], type: Gist)
  @@index([missionId])
  @@index([shipId])
  @@index([routeId])
}

model Encounter {
  id         String          @id @default(dbgenerated("gen_random_uuid()"))
  routeId    String
  legIndex   Int
  missionAId String
  missionBId String
  seed       String
  result     Json
  resolvedAt DateTime        @default(now())
  route      Route           @relation(fields: [routeId], references: [id])
  missionA   MissionInstance @relation("EncounterMissionA", fields: [missionAId], references: [id])
  missionB   MissionInstance @relation("EncounterMissionB", fields: [missionBId], references: [id])

  // D1 "exactly one Encounter row": the resolver orders mission ids (A < B) before insert,
  // so a double resolution of the same overlap hits this key instead of duplicating.
  @@unique([missionAId, missionBId, routeId, legIndex])
  @@index([routeId])
}

model DropTable {
  id     String @id
  source String
  tiers  Json
}

model Material {
  id              String           @id
  displayName     Json
  description     Json
  rarity          Rarity
  basePrice       Int
  // Sells for exactly basePrice at every port (scrap): no isolation, faction, mood or sell ratio.
  fixedPrice      Boolean          @default(false)
  active          Boolean          @default(true)
  playerMaterials PlayerMaterial[]
}

model PartInstance {
  id            String       @id @default(dbgenerated("gen_random_uuid()"))
  partType      String
  ownerPlayerId String
  condition     Float
  location      PartLocation @default(INVENTORY)
  shipId        String?
  propRoll      Json?
  connectors    Json?
  partCatalog   PartCatalog  @relation(fields: [partType], references: [partType])
  owner         Player       @relation(fields: [ownerPlayerId], references: [id])
  ship          Ship?        @relation(fields: [shipId], references: [id])

  @@index([ownerPlayerId, location])
  @@index([shipId])
}

model ShipFormat {
  id          String   @id
  displayName Json
  description Json
  cells       Json
  cellTarget  Int?
  minRarity   Rarity
  active      Boolean  @default(true)
  ships       Ship[]
}

model Ship {
  id                String            @id @default(dbgenerated("gen_random_uuid()"))
  ownerPlayerId     String
  name              String
  layout            Json
  fuel              Float             @default(0)
  status            ShipStatus        @default(IN_PORT)
  currentLocationId String
  stance            ShipStance        @default(NEUTRAL)
  energyMode        String            @default("FULL")
  formatId          String            @default("classic_square")
  owner             Player            @relation(fields: [ownerPlayerId], references: [id])
  parts             PartInstance[]
  location          Location          @relation(fields: [currentLocationId], references: [id])
  missions          MissionInstance[]
  presences         RoutePresence[]
  repairJobs        RepairJob[]
  format            ShipFormat        @relation(fields: [formatId], references: [id])

  @@index([currentLocationId])
  @@index([ownerPlayerId])
}

enum RepairJobStatus {
  PENDING
  COMPLETED
}

model RepairJob {
  id              String          @id @default(dbgenerated("gen_random_uuid()"))
  shipId          String
  playerId        String
  targets         Json
  cost            Int
  durationSeconds Int
  status          RepairJobStatus @default(PENDING)
  startedAt       DateTime        @default(now())
  completesAt     DateTime
  ship            Ship            @relation(fields: [shipId], references: [id])

  // Hand-written partial unique lives only in migration 0015_repair_jobs (Prisma PSL
  // cannot express WHERE): one PENDING job per ship, the hard guard for double-start.
  @@index([status, completesAt])
  @@index([shipId, status])
}

model PlayerMaterial {
  playerId   String
  materialId String
  quantity   Int      @default(0)
  player     Player   @relation(fields: [playerId], references: [id])
  material   Material @relation(fields: [materialId], references: [id])

  @@id([playerId, materialId])
}
