{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "declaration": true,
    "removeComments": true,
    "types": ["node", "jest"],
    "outDir": "./dist",
    "rootDir": "."
  },
  "include": ["src", "test", "jest.config.ts"]
}
