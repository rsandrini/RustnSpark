# Production on one server (docker compose --env-file .env.prod --profile prod ...).
# Copy to .env.prod on the SERVER, fill it in, and never commit it.

# Secrets: openssl rand -base64 48   (>= 32 chars each)
JWT_ACCESS_SECRET=
COOKIE_SECRET=

# Postgres password for the database container. Use hex so it is safe inside a URL:
# openssl rand -hex 24
PROD_POSTGRES_PASSWORD=

# The public address players type, with https and no trailing slash. Used for CORS and the
# password-reset link.
CORS_ORIGINS=https://game.example.com
WEB_URL=https://game.example.com

# Cloudflare tunnel token (Zero Trust > Networks > Tunnels > your tunnel > Install). The tunnel's public
# hostname must point at the service http://web-prod:80
CLOUDFLARE_TUNNEL_TOKEN=

# Email (Resend): password reset and the in-game bug report.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=RustnSpark
BUG_REPORT_TO_EMAIL=
