# Production on one server (docker compose --env-file .env.prod --profile prod ...).
# Copy to .env.prod on the SERVER, fill it in, and never commit it.

# Secrets: openssl rand -base64 48   (>= 32 chars each)
JWT_ACCESS_SECRET=
COOKIE_SECRET=

# YOUR Postgres 16 and Redis 7 (nothing in this stack runs a database). The credentials live in the URLs:
#   Postgres: postgresql://USER:PASSWORD@HOST:5432/DATABASE   (add ?sslmode=require for TLS)
#   Redis:    redis://:PASSWORD@HOST:6379                      (user and password: redis://USER:PASSWORD@HOST:6379)
#             rediss://... for TLS; redis://HOST:6379 when it has no password
# Create the empty database and a user that owns it first. On the Docker host itself use
# host.docker.internal as HOST. Special characters in a password must be URL-encoded (@ -> %40, : -> %3A,
# / -> %2F, # -> %23), or use a hex password.
DATABASE_URL=postgresql://rustandspark:CHANGE_ME@host.docker.internal:5432/rustandspark
REDIS_URL=redis://:CHANGE_ME@host.docker.internal:6379

# The public address players type, with https and no trailing slash. Used for CORS and the
# password-reset link.
CORS_ORIGINS=https://game.example.com
WEB_URL=https://game.example.com

# Cloudflare tunnel token (Zero Trust > Networks > Tunnels > your tunnel > Install). The tunnel's public
# hostname must point at the service http://web-prod:80
CLOUDFLARE_TUNNEL_TOKEN=

# Email (Resend): password reset and the in-game bug report.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=RustnSpark
BUG_REPORT_TO_EMAIL=

# Sentry error tracking (blank = off). Create TWO projects in Sentry: a Node one for the API and worker
# (SENTRY_DSN), and a React/browser one for the web app (SENTRY_WEB_DSN). The web DSN is baked into the web
# image at build time, so rebuild the web image after changing it.
SENTRY_DSN=
SENTRY_WEB_DSN=
